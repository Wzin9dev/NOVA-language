{
  "name": "nova-language",
  "displayName": "NOVA Language",
  "description": "Suporte a sintaxe, snippets e LSP para a linguagem NOVA",
  "version": "0.1.0",
  "publisher": "nova",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Themes"],
  "contributes": {
    "languages": [{
      "id": "nova",
      "aliases": ["NOVA", "nova"],
      "extensions": [".nova"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nova",
      "scopeName": "source.nova",
      "path": "./syntaxes/nova.tmLanguage.json"
    }],
    "snippets": [{ "language": "nova", "path": "./snippets/nova.json" }],
    "themes": [{
      "label": "NOVA Dark",
      "uiTheme": "vs-dark",
      "path": "./themes/nova-dark.json"
    }]
  }
}
